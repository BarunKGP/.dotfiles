[core]
	excludesfile = ~/.gitignore_global
	editor = nvim

[init]
	defaultBranch = main

[pull]
	rebase = false

[alias]
	st = status
	lg = log --oneline --graph --decorate --all
	co = checkout
	br = branch

# Set user.name and user.email per machine using:
#   git config --global user.name "Your Name"
#   git config --global user.email "your.email@example.com"
