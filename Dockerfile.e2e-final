# Final E2E test Dockerfile with all pieces including nvm custom install
# Builds dotctl from standalone github.com/BarunKGP/dotctl repository

FROM golang:1.22-alpine AS builder

ARG DOTCTL_REPO=https://github.com/BarunKGP/dotctl.git
ARG DOTCTL_BRANCH=main

RUN apk add --no-cache git
RUN git clone --branch ${DOTCTL_BRANCH} ${DOTCTL_REPO} /build-dotctl
WORKDIR /build-dotctl
RUN go build -o bin/dotctl ./cmd/dotctl

FROM alpine:latest

ARG DOTFILES_REPO=https://github.com/BarunKGP/.dotfiles.git
ARG DOTFILES_BRANCH=feat/modularize

RUN apk add --no-cache \
    openssh openssh-client git stow bash curl vim util-linux sudo shadow

COPY --from=builder /build-dotctl/bin/dotctl /usr/local/bin/dotctl

RUN addgroup -g 1000 testuser && \
    adduser -D -u 1000 -G testuser -s /bin/bash testuser && \
    echo "testuser:test" | chpasswd

RUN mkdir -p /etc/sudoers.d && \
    echo "testuser ALL=(root) NOPASSWD: /sbin/apk, /usr/sbin/usermod" \
        >> /etc/sudoers.d/testuser && \
    chmod 0440 /etc/sudoers.d/testuser

RUN mkdir -p /home/testuser && chown -R testuser:testuser /home/testuser
USER testuser
ENV HOME=/home/testuser
RUN git clone --branch ${DOTFILES_BRANCH} ${DOTFILES_REPO} ${HOME}/.dotfiles

# Copy updated configuration files and scripts
COPY packages.conf ${HOME}/.dotfiles/packages.conf
COPY dotctl.yaml.example ${HOME}/.dotfiles/dotctl.yaml.example
COPY scripts/packages/ ${HOME}/.dotfiles/scripts/packages/

# Install (includes Go, Python3, nvm)
USER root
RUN cd /home/testuser/.dotfiles && \
    echo "=== Installation Configuration ===" && \
    echo "Packages in packages.conf:" && \
    grep -E "^[a-z]" packages.conf && \
    echo "" && \
    echo "=== Running: dotctl install --skip-optional ===" && \
    HOME=/home/testuser dotctl install --skip-optional && \
    chown -R testuser:testuser /home/testuser

# Verify installations
RUN echo "" && \
    echo "=== Verification ===" && \
    go version && \
    python3 --version && \
    ([ -s /home/testuser/.nvm/nvm.sh ] && echo "✓ nvm installed" || echo "✗ nvm NOT installed") && \
    echo "" && \
    echo "=== Language Environment ===" && \
    ([ -s /home/testuser/.config/shell/generated/languages.sh ] && \
     echo "✓ Language environment generated" && \
     head -5 /home/testuser/.config/shell/generated/languages.sh || \
     echo "✗ Language environment NOT generated")

USER root
RUN if command -v zsh >/dev/null 2>&1; then \
        usermod -s "$(command -v zsh)" testuser; \
    fi

RUN ssh-keygen -A && \
    mkdir -p /home/testuser/.ssh && chmod 700 /home/testuser/.ssh && \
    chown -R testuser:testuser /home/testuser/.ssh

RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config

RUN cat > /etc/motd << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║  Phase 005 E2E Test: New dotctl Repository                  ║
╠══════════════════════════════════════════════════════════════╣
║  Standalone dotctl from: ~/Projects/dev/Github/dotctl       ║
║  Dotfiles from: feat/modularize branch                      ║
║  Installation: dotctl install --skip-optional              ║
║                                                              ║
║  Installed:                                                  ║
║  ✓ Go (1.25.7)                                              ║
║  ✓ Python3 (3.12.12)                                        ║
║  ✓ nvm (Node Version Manager)                               ║
║  ✓ Shell: zsh with dotfiles configuration                  ║
║  ✓ Language environment: ~/.config/shell/generated/languages.sh
║                                                              ║
║  SSH:  testuser / test  |  Port: 2223                       ║
╚══════════════════════════════════════════════════════════════╝
EOF

CMD ["/usr/sbin/sshd", "-D", "-e"]
EXPOSE 22
